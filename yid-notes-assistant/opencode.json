{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "deny",
      "/workspace": "allow",
      "/workspace/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow"
    },
    "edit": {
      "*": "deny",
      "/workspace": "allow",
      "/workspace/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow"
    },
    "glob": {
      "*": "deny",
      "/workspace": "allow",
      "/workspace/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow"
    },
    "external_directory": {
      "*": "deny",
      "/workspace": "allow",
      "/workspace/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow"
    }
  }
}